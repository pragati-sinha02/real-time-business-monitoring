# Copy this file to ".env" and edit the values. NEVER commit ".env" to GitHub.
# If your password contains the # character, wrap it in quotes: DB_PASSWORD="pa#ss"
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=Pug@123
DB_NAME=business_monitor

# Dashboard talks to this API address
API_URL=http://127.0.0.1:8000

# Generator settings
ANOMALY_RATE=0.02
TXN_INTERVAL_SECONDS=1.0
SIM_BASE_GAP_SECONDS=30
N_CUSTOMERS=300
SCENARIO_RATE=0.001
HISTORY_DAYS=7
# RANDOM_SEED=42

# Detection settings
CONTAMINATION=0.02
Z_THRESHOLD=3.0
PIPELINE_INTERVAL_SECONDS=5
LOOKBACK_HOURS=168
ALERT_RISK_THRESHOLD=61
ALERT_WINDOW_HOURS=3